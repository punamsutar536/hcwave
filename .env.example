# =============================================================================
# hcwave environment variables – TEMPLATE. Copy to `.env` for local runs.
#
#   * Local (docker compose): only the DEV section is needed; everything else
#     runs offline (console WhatsApp, offline LLM, local storage).
#   * Azure (AKS): these values are NOT stored in files. They come from Azure
#     Key Vault through the Secrets Store CSI driver (see deploy/helm). Most
#     Azure services use workload identity, so their *_KEY values stay empty.
# =============================================================================

# ---- Core -------------------------------------------------------------------
APP_ENV=dev                                   # dev | test | staging | prod
APP_SECRET_KEY=change-me-to-a-long-random-string   # HMAC key (cookies, OTP hashing)
PUBLIC_BASE_URL=http://localhost:8000
REPORTS_BASE_URL=                             # e.g. https://reports.hospital.example
STAFF_UI_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# ---- Database (PostgreSQL) --------------------------------------------------
DATABASE_URL=postgresql+asyncpg://hcwave:hcwave@localhost:5432/hcwave
DATABASE_AUTH_MODE=password                   # azure_ad in AKS (workload identity)
DATABASE_SSL_MODE=disable                     # require on Azure

# ---- Identity (Azure) -------------------------------------------------------
AZURE_IDENTITY_MODE=default                   # default | workload_identity | managed_identity | none
AZURE_CLIENT_ID=                              # user-assigned identity client ID (set by Helm)
AZURE_TENANT_ID=

# ---- Messaging channel ------------------------------------------------------
MESSAGING_PROVIDER=console                    # acs_whatsapp | meta_cloud | console
ACS_ENDPOINT=                                 # https://<acs>.india.communication.azure.com
ACS_ACCESS_KEY=                               # leave empty to use Entra ID
DEMO_HOSPITAL_CHANNEL_IDS=console             # ACS WhatsApp channel registration ID(s)
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=

# ---- Queue ------------------------------------------------------------------
QUEUE_PROVIDER=in_memory                      # azure_service_bus | redis | in_memory
SERVICEBUS_NAMESPACE=                         # <ns>.servicebus.windows.net
SERVICEBUS_CONNECTION_STRING=
REDIS_URL=redis://localhost:6379/0

# ---- LLMs (profiles: intent, reply, tagger, embedding) ----------------------
LLM_INTENT_PROVIDER=fake                      # azure_openai | anthropic_foundry | openai_compatible | fake
LLM_INTENT_MODEL=gpt-5-mini
LLM_REPLY_PROVIDER=fake
LLM_REPLY_MODEL=gpt-5
LLM_TAGGER_PROVIDER=fake
LLM_TAGGER_MODEL=gpt-5-mini
LLM_EMBEDDING_PROVIDER=fake
LLM_EMBEDDING_MODEL=text-embedding-3-large
AZURE_OPENAI_ENDPOINT=                        # Foundry endpoint or APIM gateway URL
AZURE_OPENAI_API_KEY=                         # empty = Entra ID; APIM subscription key if via APIM
ANTHROPIC_FOUNDRY_BASE_URL=                   # https://<resource>.services.ai.azure.com/anthropic
ANTHROPIC_FOUNDRY_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# ---- Knowledge search (RAG) -------------------------------------------------
KNOWLEDGE_PROVIDER=keyword                    # azure_ai_search | pgvector | keyword
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=

# ---- Language / safety ------------------------------------------------------
LANGUAGE_PROVIDER=heuristic                   # azure_translator | heuristic
AZURE_TRANSLATOR_ENDPOINT=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
SAFETY_PROVIDER=none                          # azure_content_safety | none
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=

# ---- Storage ----------------------------------------------------------------
STORAGE_PROVIDER=local                        # azure_blob | s3 | local
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONNECTION_STRING=
LOCAL_STORAGE_ROOT=.data/blobs
S3_BUCKET_PREFIX=

# ---- Email / SMS ------------------------------------------------------------
EMAIL_PROVIDER=console                        # acs_email | smtp | console
EMAIL_SENDER=DoNotReply@example.com
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMS_PROVIDER=console                          # acs_sms | msg91 | console
ACS_SMS_FROM=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# ---- Dashboard / HIS --------------------------------------------------------
DASHBOARD_PROVIDER=builtin                    # power_bi | grafana | builtin
POWERBI_WORKSPACE_ID=
POWERBI_REPORT_ID=
GRAFANA_URL=
HIS_PROVIDER=csv                              # csv | rest_api | fhir | none
HIS_API_BASE_URL=
HIS_API_TOKEN=
FHIR_URL=

# ---- Auth -------------------------------------------------------------------
AUTH_PROVIDER=disabled                        # entra_id in Azure (disabled = dev only!)
STAFF_API_AUDIENCE=                           # api://hcwave-staff-api
INTERNAL_AUTH_MODE=shared_secret              # entra_id in Azure
INTERNAL_API_AUDIENCE=                        # api://hcwave-internal-api
INTERNAL_ALLOWED_CLIENT_IDS=                  # Logic App / Function App identity client IDs
INTERNAL_API_TOKEN=dev-internal-token
EVENTGRID_WEBHOOK_KEY=                        # only for Event Grid webhook delivery

# ---- Scheduling -------------------------------------------------------------
SCHEDULER_ENGINE=none                         # logic_apps | k8s_cronjob | none
FEEDBACK_ENGINE=jobs                          # durable_functions | jobs
DURABLE_FEEDBACK_START_URL=
DURABLE_FUNCTIONS_AUDIENCE=

# ---- Telemetry --------------------------------------------------------------
TELEMETRY_EXPORTER=none                       # azure_monitor | otlp | console | none
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Hospital contacts (demo tenant) ----------------------------------------
DEMO_PR_EMAIL=patient.relations@example.com
DEMO_PR_PHONE=+919800000001
DEMO_UNIT_HEAD_EMAIL=unit.head@example.com
DEMO_UNIT_HEAD_PHONE=+919800000002
